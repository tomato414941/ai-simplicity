# OpenAI: a key for a project that can use the Agents API. The server alone holds it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Supabase: sign-in and storage. The publishable key verifies users; the secret key reads and writes the tables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

HOST=127.0.0.1
PORT=3000

# Foundation, optional: registered there as an integration, its key and webhook secret shown once.
# Without these, conversations carry no key to Foundation.
FOUNDATION_URL=
FOUNDATION_INTEGRATION_KEY=
FOUNDATION_WEBHOOK_SECRET=
